HOST=127.0.0.1
PORT=8900
DATABASE_URL=sqlite://data/daroyan.db?mode=rwc
DUCKDB_PATH=data/daroyan.duckdb
RETENTION_DAYS=30
LOG_RETENTION_DAYS=7
TRUSTED_PROXIES=127.0.0.1,::1
CLIENT_IP_HEADER=cf-connecting-ip
APP_URL=http://localhost:3910
# Sign-in integrations. Leave a pair empty to turn that integration off.
SLACK_API_URL=https://slack.com
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# Google sign-in. Create an OAuth client with the redirect URI APP_URL/v1/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who can sign in: emails, or @domain for a whole domain, separated by commas.
ALLOWED_EMAILS=
# Let uptime checks and webhooks reach localhost and private networks.
ALLOW_PRIVATE_TARGETS=false
# A folder for a DuckDB snapshot every 6 hours. Leave it empty to turn the snapshots off.
DUCKDB_BACKUP_DIR=
